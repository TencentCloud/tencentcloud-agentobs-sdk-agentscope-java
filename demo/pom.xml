<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      本地测试子工程：仅用于联调验证 Aliyun ARMS Java agent 与我们 SDK 共存的场景。
      不参与发布，不进主工程 build。
    -->
    <groupId>com.tencentcloudapi.observability.testbench</groupId>
    <artifactId>demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>cls-sdk-aliyun-coexistence-demo</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 待验证的 SDK (0.0.5, 已 shade OTel API，刚装入本地仓库) -->
        <dependency>
            <groupId>com.tencentcloudapi.observability</groupId>
            <artifactId>tencentcloud-agentobs-sdk-agentscope-java</artifactId>
            <version>0.0.5</version>
        </dependency>

        <!-- 客户生产环境使用的 AgentScope 版本 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!--
          真实 OpenAI 兼容模型实现（OpenAIChatModel extends ChatModelBase）。
          baseUrl 可配，因此通义 / DeepSeek / 智谱 / Moonshot 等兼容接口都能用。
          仅当 .env 里提供了 LLM_API_KEY 时才会被 demo 使用，否则回退 MockChatModel。
          注：该扩展最低发布版本为 2.0.2，比 core 2.0.1 略新；两者 API 兼容。
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>2.0.2</version>
        </dependency>

        <!--
          真实的 agentscope-harness，提供 MemoryFlushMiddleware —— 「记忆抽取」这一类
          绕过中间件链的模型调用的真实来源。版本 2.0.1 与 core 2.0.1 完全对齐
          （harness 只依赖 core + jackson-yaml + commons-compress + sqlite-jdbc）。
          引入真包而非自己模拟，才能保证验证的是上游真实调用形态：
              next.apply(input).concatWith(Mono.defer(..).subscribeOn(boundedElastic))
          注：另一个候选 agentscope-extensions-autocontext-memory 只发布到 1.1.0-RC2，
          面向 core 1.x 构建（implements core.state.StateModule、引用 core.session.Session，
          二者在 core 2.0.x 中均不存在），在本工程无法加载。
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- 简单的 SLF4J binder，让日志能打出来 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>demo-shaded</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.tencentcloudapi.observability.testbench.DemoMain</mainClass>
                                </transformer>
                                <!-- 合并 META-INF/services (SPI, 否则 OTel / Reactor 等 provider 会丢) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

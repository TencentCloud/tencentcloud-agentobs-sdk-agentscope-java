<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tencentcloudapi.observability</groupId>
    <artifactId>tencentcloud-agentobs-sdk-agentscope-java</artifactId>
    <version>0.0.4</version>
    <packaging>jar</packaging>

    <name>tencentcloud-agentobs-sdk-agentscope-java</name>
    <description>
        Tencent Cloud CLS observability SDK for AgentScope Java (v2), enhanced.
        Ships its own ClsTracingMiddleware that captures the fields the stock
        OtelTracingMiddleware omits — session.id / user.id, tool arguments,
        streamed tool results, and reasoning thoughts — and exports OpenTelemetry
        spans to Tencent Cloud CLS via the standard OTLP/HTTP protocol.
    </description>
    <url>https://github.com/TencentCloud/tencentcloud-agentobs-sdk-agentscope-java</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>


    <developers>
        <developer>
            <id>tencentcloudapi</id>
            <name>tencentcloudapi</name>
            <email>tencentcloudapi@tencent.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/TencentCloud/tencentcloud-agentobs-sdk-agentscope-java.git</connection>
        <developerConnection>scm:git:ssh://github.com:TencentCloud/tencentcloud-agentobs-sdk-agentscope-java.git</developerConnection>
        <url>https://github.com/TencentCloud/tencentcloud-agentobs-sdk-agentscope-java/tree/main</url>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <opentelemetry.version>1.61.0</opentelemetry.version>
        <agentscope.version>2.0.1</agentscope.version>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.13</slf4j.version>
        <reactor.version>3.6.6</reactor.version>
    </properties>

    <dependencies>
        <!-- OpenTelemetry SDK: TracerProvider / BatchSpanProcessor wiring -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-trace</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>

        <!-- OTLP exporter: uploads spans to CLS's OTLP/HTTP trace endpoint -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>

        <!-- Jackson: JSON serialization for tool-call arguments in the middleware -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- SLF4J logging facade -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- AgentScope Java v2: middleware SPI + event/message types.
             Provided by the user's application at runtime. -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${agentscope.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Reactor: MiddlewareBase hooks return Flux; provided transitively by
             agentscope-core at runtime, but referenced directly in our middleware. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- OpenTelemetry <-> Reactor context propagation. 本 SDK 把 OTel + Reactor
             上下文传播桥一并 shade 到 jar 内部（相对于 io.opentelemetry 一起 relocate），
             这样我们的 Tracer/Context 完全脱离客户 JVM 中其他 OTel 生产者（Aliyun ARMS
             javaagent、agentscope 自带的 OtelTracingMiddleware 等）的字节码干扰。
             因此这里不再是 provided，而是打进本 jar 并被 shade。 -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-reactor-3.1</artifactId>
            <version>2.27.0-alpha</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <!-- 生成 sources.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              关键：把 OpenTelemetry 相关类（含 context / api / sdk / exporter / reactor 桥）
              以及它们的网络传输层传递依赖（OkHttp / okio / protobuf）relocate 到
              com.tencentcloudapi.observability.shaded.* 下。

              目的：让客户 JVM 中并存的其他 OpenTelemetry 生产者（Aliyun ARMS javaagent 的
              字节码增强、AgentScope 自带的 OtelTracingMiddleware 等）彻底无法通过
              io.opentelemetry.* 的类名匹配到我们 SDK 内部使用的 Tracer / Context /
              SpanBuilder —— 既不会劫持我们的 .setParent(ctx)（之前的 trace 断链根因），
              也不会把彼此的 Reactor Context key 搞混。

              因此本 SDK 发布的 jar 完全自洽，客户无需添加任何 JVM 启动参数即可工作。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 发布的 pom 中剔除已被打进 jar 的依赖；agentscope-core /
                                 reactor-core / slf4j-api / jackson 等不被 shade 的依赖
                                 保留原状。 -->
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <!-- 直接替换主 artifact，GPG / 发布流程无需调整 -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <!-- 不要为了 shade 污染客户 IDE 的符号表 -->
                            <minimizeJar>false</minimizeJar>
                            <relocations>
                                <relocation>
                                    <pattern>io.opentelemetry</pattern>
                                    <shadedPattern>com.tencentcloudapi.observability.shaded.io.opentelemetry</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>okhttp3</pattern>
                                    <shadedPattern>com.tencentcloudapi.observability.shaded.okhttp3</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>okio</pattern>
                                    <shadedPattern>com.tencentcloudapi.observability.shaded.okio</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>com.tencentcloudapi.observability.shaded.com.google.protobuf</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <!-- 自动改写 META-INF/services/* 下的 SPI 文件内容
                                     （类名跟着 relocation 一起改） -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- 合并 LICENSE / NOTICE，避免签名冲突 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                            </transformers>
                            <filters>
                                <!-- 丢掉第三方 jar 的签名文件（否则重新打包后签名失效，
                                     JVM 加载会抛 SecurityException） -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 生成 javadoc.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- GPG 签名 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <!-- setup-java action 会将 passphrase 设置到 MAVEN_GPG_PASSPHRASE 环境变量中 -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Central Publishing：发布到 Maven Central（Sonatype Central Portal） -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.8.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

# Copy this file to `.env` (git-ignored) and fill in your Tencent Cloud CLS credentials.
# Resolution priority: builder args > process env > ./.env > ~/.agentobs-agentscope/config.env

# ---- Required ----
CLS_ENDPOINT=ap-guangzhou.cls.tencentcs.com
CLS_TOPIC_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional ----
CLS_SERVICE_NAME=agentscope-demo
# CLS_SOURCE=                    # defaults to local IP
# CLS_BATCH_SIZE=32              # 1..1000
CLS_DEBUG=true                   # 1 / true / yes to enable verbose logs
# CLS_CAPTURE_FRAMEWORK_CALLS=   # 0/false/no to stop tracing calls that bypass the middleware
# CLS_PROPAGATE_ACROSS_SCHEDULERS=   # 0/false/no to skip the Schedulers hook that correlates
                                     # detached post-turn memory calls with their turn
# CLS_CAPTURE_FORMAT_CALLS=      # 1/true/yes to add a `format` span per prompt-formatting call.
                                 # Off by default: a formatter runs on every model call, so this
                                 # roughly doubles a turn's span count.

# ---- Demo only: real LLM (omit to run fully offline with MockChatModel) ----
# Used by demo/DemoMain, NOT by the SDK itself. Any OpenAI-compatible endpoint works.
#   Aliyun Tongyi : https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   DeepSeek      : https://api.deepseek.com/v1                        deepseek-chat
#   Zhipu         : https://open.bigmodel.cn/api/paas/v4               glm-4-plus
#   Moonshot      : https://api.moonshot.cn/v1                         moonshot-v1-8k
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_MEMORY_MODEL=              # optional, defaults to LLM_MODEL
